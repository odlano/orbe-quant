

name: ORBE QUANT - Importação de Dados

on:
  workflow_dispatch:

jobs:
  importar:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar repositorio
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Instalar bibliotecas
        run: pip install requests

      - name: Importar dados esportivos
        run: python importador_dados.py

      - name: Salvar dados importados
        uses: actions/upload-artifact@v4
        with:
          name: dados-orbe-quant
          path: dados/ligas_futebol.json
          if-no-files-found: error
          retention-days: 7
